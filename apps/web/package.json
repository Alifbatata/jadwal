		"vitest": "catalog:"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.4",
		"@jadwal/core": "workspace:*",
		"@jadwal/db": "workspace:*",
		"@jadwal/widget": "workspace:*",
