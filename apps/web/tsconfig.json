{
	// SvelteKit 3 fournit le reste (`allowJs`, `skipLibCheck`, `moduleResolution`…) et ne dit plus
	// lui-même quels fichiers vérifier : `include` est ici, et c'est celui qu'il engendrait.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		// Les scripts d'entretien de `@jadwal/db` sont du JavaScript sans annotations, exécuté par
		// Node avec son retrait de types : les vérifier ici remonterait des erreurs qui n'en sont
		// pas. Ils sont couverts par les tests du paquet, qui les lancent pour de vrai.
		"checkJs": false,
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "vite.config.ts", "tests"],
	// Le travailleur de service a sa propre configuration (`src/service-worker/tsconfig.json`) : il
	// n'a ni `document` ni `window`. `pnpm check` vérifie les deux.
	"exclude": ["src/service-worker"]
	// Les imports internes passent par `#lib`, déclaré dans `imports` du `package.json` :
	// https://svelte.dev/docs/kit/migrating-to-sveltekit-3
}
