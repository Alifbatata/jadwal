# Copier ce fichier en `.env` et adapter les valeurs. Le fichier `.env` n'est jamais commité.
#
# `pnpm lint`, `pnpm check` et `pnpm build` n'ont besoin d'aucune de ces variables. `pnpm test` en a
# besoin : les tests de `packages/db` créent leur propre base sur un vrai PostgreSQL. Sans serveur
# joignable, ils échouent avec un message qui dit quoi lancer ; ils ne passent jamais en silence.
#
# Les scripts et les tests de `packages/db` lisent ce fichier tout seuls (`loadDotEnv`). Une variable
# déjà posée dans l'environnement gagne sur le fichier : la CI passe donc les siennes sans fichier.
# Le serveur de production lit son environnement, jamais ce fichier.

# --- Tests (racine) ---
# `pnpm test` affiche un tableau par paquet — fichiers, tests, réussis, sautés, échoués — et rend la
# main en rouge s'il reste un test sauté : un test qui a besoin de PostgreSQL ou de Docker doit
# échouer quand ils manquent, jamais disparaître du décompte. Poser `1` ci-dessous tolère les tests
# sautés le temps d'un travail en cours ; ce n'est pas un réglage qui doit dormir dans un `.env`.
JADWAL_TESTS_SAUTES_TOLERES=

# --- apps/web (SvelteKit + adapter-node, en production : `node apps/web/build`) ---
# Port et adresse d'écoute du serveur Node.
PORT=3000
HOST=0.0.0.0
# Origine publique de l'application (schéma + hôte + port), utilisée pour construire les URLs absolues.
ORIGIN=http://localhost:3000

# --- Base de développement (docker-compose.dev.yml, inutile avant l'étape 2) ---
POSTGRES_USER=jadwal
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=jadwal
# Port exposé sur la machine hôte.
POSTGRES_PORT=5432

# --- packages/db (schéma, migrations, données de démonstration, tests) ---
# Hôte de la base. 127.0.0.1 plutôt que localhost : déterministe, et utilisable par psql.
POSTGRES_HOST=127.0.0.1
# Rôle propriétaire, celui du conteneur de développement : migrations, seed et tests d'infrastructure.
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB et POSTGRES_PORT sont déclarés plus haut.

# Rôles applicatifs non privilégiés (ni superutilisateur, ni BYPASSRLS, ni propriétaires).
# Les migrations les créent sans mot de passe ; `pnpm --filter @jadwal/db exec node scripts/bootstrap-roles.mjs`
# leur pose celui-ci, et ramène au passage leurs attributs à ce qu'ils doivent être.
# Ce sont ces rôles que l'application et les tests utilisent.
#
# Les deux noms ci-dessous sont ceux du rôle sous lequel l'application se connecte. Par défaut, ce
# sont ceux que posent les migrations. Y écrire un autre nom ne crée pas ce rôle : il faut d'abord
# l'ouvrir sur le serveur, et de l'une de ces deux façons, sans quoi la connexion échouerait ou
# réussirait sans aucun droit.
#   CREATE ROLE mon_role LOGIN INHERIT IN ROLE jadwal_app;   -- membre : il hérite des politiques
#   ALTER ROLE jadwal_app RENAME TO mon_role;                -- renommage : les politiques suivent
# Les politiques désignent le rôle par son identifiant interne, et PostgreSQL les applique aussi aux
# membres de ce rôle : dans les deux cas l'isolation reste entière.
# Rôle propriétaire : il possède le schéma, les tables et les fonctions, et joue les migrations.
# Ni superutilisateur, ni BYPASSRLS : la sécurité au niveau des lignes s'applique aussi à lui
# (ADR 0019). `scripts/bootstrap-roles.mjs` le crée, avec le rôle du serveur ci-dessus.
JADWAL_DB_OWNER_USER=jadwal_owner
JADWAL_DB_OWNER_PASSWORD=changez-moi-proprietaire

JADWAL_DB_APP_USER=jadwal_app
JADWAL_DB_APP_PASSWORD=changez-moi-aussi
JADWAL_DB_SUPERADMIN_USER=jadwal_superadmin
JADWAL_DB_SUPERADMIN_PASSWORD=changez-moi-encore

# Base créée et détruite par la suite de tests. Elle est recréée à chaque exécution.

# Rôle de la connexion : lui seul touche aux tables de session, de compte et de vérification.
# Le rôle applicatif n'y a aucun droit : un jeton de session lui est inaccessible (ADR 0016).
JADWAL_DB_AUTH_USER=jadwal_auth
JADWAL_DB_AUTH_PASSWORD=changez-moi-connexion

# Rôle du côté public : lecture seule, sans contexte d'organisation. Il ne voit que les
# organisations actives et les cours publiés, et n'a aucun droit sur les comptes, les adhésions,
# les invitations, les journaux ni les sessions (ADR 0026). Sa seule écriture est le compteur de
# limitation de débit, qui n'est pas une donnée d'organisation.
JADWAL_DB_PUBLIC_USER=jadwal_public
JADWAL_DB_PUBLIC_PASSWORD=changez-moi-public

JADWAL_TEST_DB=jadwal_test

# --- Courriel (apps/web) ---
# `file` (défaut) écrit chaque courriel dans un dossier et n'envoie jamais rien : c'est le mode de
# développement et de test. `smtp` envoie pour de vrai. Un oubli de configuration n'expédie donc rien.
MAIL_TRANSPORT=file
# Dossier de la corbeille de sortie du transport `file`, relatif à la racine du dépôt.
MAIL_OUTBOX_DIR=.courriels
# Adresse d'expédition, et le nom affiché à côté d'elle. L'adresse doit appartenir au domaine que
# vos enregistrements SPF et DKIM autorisent, sinon les messages partent en indésirable (ADR 0024).
MAIL_FROM=jadwal@example.test
MAIL_FROM_NAME=jadwal
# Adresse de réponse. La boîte d'envoi n'est pas lue : sans celle-ci, une personne qui répond à un
# lien de connexion écrit dans le vide. Vide : aucun en-tête Reply-To n'est posé.
MAIL_REPLY_TO=

# --- SMTP (uniquement si MAIL_TRANSPORT=smtp) ---
# Valeurs d'exemple : un compte de messagerie Infomaniak. N'importe quel fournisseur SMTP convient,
# c'est tout l'intérêt (ADR 0024).
SMTP_HOST=mail.infomaniak.com
# 587 : la connexion commence en clair et bascule en TLS par STARTTLS, qui est exigé même si le
# serveur ne l'annonce pas. 465 : TLS d'emblée. Le port suffit à choisir, il n'y a pas d'autre
# réglage à poser de travers.
SMTP_PORT=587
SMTP_USER=jadwal@example.test
SMTP_PASSWORD=

# --- Connexion (apps/web) ---
# Secret de signature des sessions. Obligatoire en production : sans lui, le serveur refuse de
# démarrer. `openssl rand -base64 32` en produit un.
BETTER_AUTH_SECRET=changez-moi-secret-de-session-tres-long
# --- Adresse réelle du visiteur, derrière un mandataire inverse ---
#
# **Ne posez ces trois valeurs que si un mandataire est vraiment devant l'application.** Un
# mandataire *ajoute* sa valeur à `X-Forwarded-For` ; la dernière est donc celle qu'il a écrite, et
# les précédentes sont celles que le visiteur a choisies. Les lire à l'envers rendrait la limitation
# de débit contournable à volonté.
#
# `ADDRESS_HEADER` et `XFF_DEPTH` sont lus par adapter-node, qui prend la valeur à `XFF_DEPTH` rangs
# depuis la **droite**. `XFF_DEPTH` est le nombre de mandataires devant nous : 1 avec un seul Caddy.
# Sans mandataire, laissez `ADDRESS_HEADER` vide — adapter-node lèverait une erreur sur toute requête
# qui n'aurait pas l'en-tête.
ADDRESS_HEADER=
XFF_DEPTH=1
# Les mêmes mandataires, en notation CIDR séparée par des virgules, pour Better Auth — qui relit
# l'en-tête lui-même et a besoin de savoir qui sauter. Vide : rien n'est de confiance.
JADWAL_TRUSTED_PROXIES=
# L'en-tête que Better Auth lit. Ne change qu'avec un mandataire qui en écrirait un autre.
JADWAL_IP_HEADER=x-forwarded-for
# Origines autorisées à intégrer les pages publiques dans un cadre (ADR 0027).
# **Vide : tout le monde**, et c'est le réglage par défaut du service hébergé — une organisation
# doit pouvoir coller son programme sur son propre site sans nous écrire. Remplir cette liste restreint
# l'ouverture aux origines nommées, séparées par des virgules, pour une instance qui le voudrait.
JADWAL_EMBED_ORIGINS=

# --- Widget (apps/web) ---
# Page d'essai d'intégration `/widget/test`, et organisation qu'elle affiche par défaut.
# **Ce réglage ouvre la page** : sans lui, `/widget/test` répond 404. C'est un outil de mise au
# point, pas une page du service — une instance en production n'a aucune raison de l'ouvrir.
# Rempli, il donne aussi l'organisation affichée par défaut ; `?org=<identifiant>` prime toujours.
JADWAL_WIDGET_TEST_ORG=

# --- Import des heures de prière (apps/web) ---
# Taille maximale d'un corps de requête, lue par adapter-node. Le défaut d'adapter-node est 512K,
# et l'écran des heures de prière l'affiche tel quel pour expliquer un refus. Un calendrier d'un an
# au format CSV pèse environ 25 Ko, soit vingt fois moins : la relever n'a d'intérêt que pour un
# usage particulier, et l'abaisser protège d'un envoi massif.
BODY_SIZE_LIMIT=512K
