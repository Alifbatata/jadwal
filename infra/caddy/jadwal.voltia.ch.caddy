# Le bloc de site de jadwal, à poser dans la configuration du Caddy **de l'hôte** (ADR 0034).
#
# Ce fichier est **additif** : il décrit un site de plus, il ne touche à aucun autre. Le retirer et
# recharger Caddy suffit à faire disparaître jadwal sans que les autres sites que ce Caddy peut
# servir s'en aperçoivent.
#
# Il suppose que le Caddyfile de l'hôte contient un `import` d'un répertoire de sites — c'est la
# disposition la plus courante, et le playbook la vérifie avant de poser ce fichier. Si ce n'est pas
# le cas, il ne l'installe pas et le dit.

jadwal.voltia.ch {
	# Le certificat est demandé à Let's Encrypt par Caddy lui-même, comme pour tout site qu'il sert.
	# Rien à renouveler à la main : c'est Caddy qui s'en occupe, et la veille surveille sa date
	# d'expiration au cas où il n'y arriverait pas.

	# La compression : zstd pour qui l'accepte, gzip pour les autres. Mesuré à l'étape 16 : rien
	# n'était compressé, alors que l'application annonce `Vary: accept-encoding`. `pnpm caddy:test`
	# mesure le gain à chaque passage. Le 2026-09-25 : 64 % de moins en gzip et 63 % en zstd sur le
	# texte de `/conditions` (16 882 octets), 51 % et 49 % sur le widget (4 239 octets). À ces
	# tailles, zstd au niveau par défaut de Caddy pèse 2 à 4 % de plus que gzip, soit 143 octets de
	# plus sur la page et 82 sur le widget.
	#
	# `encode` enveloppe la réponse de `reverse_proxy`. Caddy lui donne sa place dans la chaîne où
	# qu'on l'écrive : il est ici pour se lire à côté du mandataire dont il compresse les réponses.
	# L'ordre `zstd gzip` départage un client qui accepte les deux au même poids, comme le fait un
	# navigateur. Brotli n'y est pas : Caddy ne l'a pas sans module tiers.
	#
	# Ce qu'il fait en passant, et que `pnpm caddy:test` vérifie : il ajoute `Accept-Encoding` à
	# `Vary`, sans doublon ; il suffixe l'ETag forte de la réponse compressée (`-zstd`, `-gzip`),
	# puisque c'est une autre représentation, et retire ce suffixe de `If-None-Match` avant de
	# passer la requête à l'application, dont le `304` marche donc comme avant.
	#
	# Ce qu'il ne fait pas : il ne touche pas à une réponse déjà compressée. Les fichiers de
	# `/_app/immutable/` passent donc tels quels vers un client qui accepte brotli ou gzip :
	# adapter-node les lui sert déjà compressés. Un client qui n'accepte que zstd les reçoit en clair
	# de l'application, et `encode` les compresse. Il ne touche pas non plus à une réponse de moins
	# de 512 octets, ni aux types hors de sa liste (PNG, PDF), ni à une réponse marquée
	# `Cache-Control: no-transform`. Pour un client qui n'accepte ni zstd ni gzip, il ne compresse
	# pas et n'ajoute pas `Vary` : une réponse en clair qu'un cache partagé servirait à tous ne fait
	# de tort à personne. L'empreinte `integrity` du widget ne change pas : elle porte sur le corps
	# décodé.
	#
	# Trois écarts, relevés en 2.8.0 comme en 2.11.4. Il compresse aussi une réponse `206`, mais
	# garde le `Content-Range` de la forme brute. sirv, qui sert les fichiers de `/_app/` pour
	# adapter-node, répond aux plages. Un navigateur reçoit le fichier déjà compressé en brotli ou en
	# gzip, qu'`encode` laisse passer. Mais un client qui n'accepte que zstd reçoit une plage
	# compressée dont le `Content-Range` ne décrit pas le corps. Les routes de l'application, elles,
	# ne servent pas de plages. En `HEAD`, il annonce dans `Content-Length` la taille d'un flux
	# compressé vide (20 octets en gzip). Un `304` rend l'ETag sans le suffixe de compression.
	#
	# BREACH ne trouve rien à lire ici : il lui faut, dans un même corps compressé, un secret stable
	# et un texte choisi par l'attaquant. Le nonce de la politique de contenu change à chaque
	# réponse ; aucun formulaire ne porte de jeton, SvelteKit contrôle l'origine ; le jeton de
	# session ne paraît que dans les corps de `/api/auth/get-session` et `/api/auth/list-sessions`
	# de Better Auth, qui ne reprennent rien de la requête ; les pages publiques reprennent des
	# paramètres de la requête, mais ne lisent aucune session. Une réponse qui mettrait un jeton
	# durable à côté d'un texte venu de la requête demanderait de revoir ce point.
	encode zstd gzip

	# L'application, sur la boucle locale. Compose n'y publie le port que là : rien d'autre que ce
	# reverse_proxy ne peut l'atteindre.
	reverse_proxy 127.0.0.1:3080 {
		# Caddy **ajoute** son adresse à X-Forwarded-For plutôt que de le remplacer, ce qui est le
		# comportement correct — et c'est pour cela que l'application lit la **dernière** valeur
		# (`XFF_DEPTH=1`). Les trois en-têtes ci-dessous sont ceux qu'adapter-node consulte.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# Une application qui ne répond plus ne doit pas retenir un visiteur indéfiniment.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	# Les en-têtes de sécurité sont posés par l'application elle-même, route par route — c'est là
	# qu'on sait si une page publique accepte d'être encadrée (ADR 0027). Caddy n'en ajoute qu'un,
	# celui qu'il est le seul à pouvoir poser honnêtement, parce qu'il est le seul à savoir que la
	# connexion est bien en HTTPS.
	header {
		# Deux ans, sous-domaines compris. `preload` n'y est pas : il engage `voltia.ch` tout entier
		# auprès des navigateurs, et ce n'est pas à jadwal d'en décider.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Caddy annonce sa version dans `Server` ; rien n'oblige à la publier.
		-Server
	}

	# `/healthz` ne va pas au journal (ADR 0039 complété). Ce n'est pas du confort : la sonde de
	# l'ADR 0038 interroge cette adresse toutes les cinq minutes, sur les deux piles, depuis le
	# serveur lui-même — **576 lignes par jour** qui ne disent rien de personne et qui, sur les
	# quatorze jours de rétention, seraient largement majoritaires. Un journal où le bruit couvre le
	# reste est un journal qu'on ne lit plus.
	#
	# Ce qui est perdu, et pourquoi c'est acceptable : une panne de la sonde ne se verra plus ici.
	# Elle se voit ailleurs, et mieux — c'est le silence des battements de cœur que la supervision
	# extérieure entend, pas une ligne de journal qu'il faudrait aller chercher.
	#
	# `log_skip` demande Caddy 2.8.0 ou plus : la directive s'appelait `skip_log` avant, et un
	# Caddyfile qui la nomme ainsi est **refusé** par une version plus ancienne. Le rôle Ansible
	# vérifie donc la version avant de poser ce fichier — sans quoi le déploiement remplacerait une
	# configuration valide par une configuration que Caddy refuse de charger.
	log_skip /healthz

	# Le journal du site, dans un fichier à lui : on lit ce que jadwal a servi, et rien d'autre.
	#
	# Un journal d'accès ordinaire est une base de données personnelles qu'on n'a pas voulue :
	# l'adresse du visiteur, la page qu'il a demandée, et — pour peu qu'une adresse porte un
	# secret — de quoi ouvrir son compte. `docs/CONDITIONS.md` promet qu'un visiteur ne laisse pas
	# d'adresse complète ; cette promesse se tient ici, pas ailleurs, parce que Caddy écrit avant
	# que l'application ne voie quoi que ce soit.
	#
	# Ce que `format filter` retire, et pourquoi chaque ligne y est :
	#
	#   - **l'adresse du visiteur**, tronquée en /24 et /48 partout où elle paraît : celle que voit
	#     Caddy (`remote_ip`), celle qu'il a résolue (`client_ip`), et celle que porte l'en-tête
	#     `X-Forwarded-For`. Un /24 garde de quoi reconnaître un abus, il ne désigne plus personne ;
	#   - **le jeton de connexion**, dans la requête comme dans le chemin. Le lien magique est un
	#     mot de passe à usage unique : `?token=…` sur `/api/auth/magic-link/verify` ouvre la
	#     session de quelqu'un. Deux formes existent, et la même expression couvre les deux ;
	#   - **l'en-tête `Referer`**, supprimé. Après la redirection du lien magique, le navigateur le
	#     renvoie avec le jeton dedans : filtrer l'adresse sans filtrer le renvoyeur ne servirait à
	#     rien. Il dit aussi d'où vient le visiteur, ce que ce service n'a pas à savoir.
	#
	# `Cookie`, `Authorization` et `Set-Cookie` ne sont pas dans la liste : Caddy les vide déjà de
	# lui-même. Vérifié, pas supposé — voir `scripts/eprouver-journal-caddy.mjs`, qui rejoue ce bloc
	# dans un conteneur et relit la ligne écrite.
	log {
		output file /var/log/caddy/jadwal.voltia.ch.log {
			roll_size 10MiB
			# Quatorze jours, et pas un de plus. `roll_keep_for` borne les fichiers déjà roulés ;
			# le fichier **courant**, lui, n'a aucune borne de temps chez Caddy, qui ne roule qu'à
			# la taille. C'est la minuterie `jadwal-journal-caddy` qui le coupe chaque nuit, et
			# l'ADR 0039 dit pourquoi ce n'est pas `logrotate` qui le fait.
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>X-Forwarded-For ip_mask {
					ipv4 24
					ipv6 48
				}
				request>uri regexp "(token=|/reset-password/)[^&/?]+" "${1}REDACTED"
				request>headers>Referer delete
			}
		}
	}
}
