# Le bloc de site de jadwal, à poser dans la configuration du Caddy **de l'hôte** (ADR 0034).
#
# Ce fichier est **additif** : il décrit un site de plus, il ne touche à aucun autre. Le retirer et
# recharger Caddy suffit à faire disparaître jadwal sans que les autres sites que ce Caddy peut
# servir s'en aperçoivent.
#
# Il suppose que le Caddyfile de l'hôte contient un `import` d'un répertoire de sites — c'est la
# disposition la plus courante, et le playbook la vérifie avant de poser ce fichier. Si ce n'est pas
# le cas, il ne l'installe pas et le dit.

jadwal.voltia.ch {
	# Le certificat est demandé à Let's Encrypt par Caddy lui-même, comme pour tout site qu'il sert.
	# Rien à renouveler à la main : c'est Caddy qui s'en occupe, et la veille surveille sa date
	# d'expiration au cas où il n'y arriverait pas.

	# La compression : gzip d'abord, zstd pour le client qui ne veut que lui ou qui le préfère.
	# Mesuré à l'étape 16 : rien n'était compressé, alors que l'application annonce
	# `Vary: accept-encoding`. `pnpm caddy:test` mesure le gain à chaque passage. Le 2026-09-26 :
	# 64 % de moins en gzip et 63 % en zstd sur le texte de `/conditions` (16 852 octets), 51 % et
	# 49 % sur le widget (4 405 octets). À ces tailles, zstd au niveau par défaut de Caddy pèse 2 à
	# 4 % de plus que gzip : 150 octets de plus sur la page, 82 sur le widget.
	#
	# `encode` enveloppe la réponse de `reverse_proxy`. Caddy lui donne sa place dans la chaîne où
	# qu'on l'écrive : il est ici pour se lire à côté du mandataire dont il compresse les réponses.
	#
	# L'ordre des formats compte. La documentation de Caddy le dit : quand le client accepte
	# plusieurs formats sans en préférer un par son poids (`q`), c'est le premier de la liste qui
	# sert. Un navigateur envoie `gzip, deflate, br, zstd`, sans poids : avec `gzip zstd`, il
	# reçoit gzip, le plus petit des deux ici. Jusqu'à l'étape 18, l'ordre était `zstd gzip`, et le
	# navigateur recevait zstd. zstd reste pour le client qui n'accepte que lui, ou qui le demande
	# avec un poids plus haut. Brotli n'y est pas : Caddy ne l'a pas sans module tiers.
	#
	# Ce qu'il fait en passant, et que `pnpm caddy:test` vérifie : il ajoute `Accept-Encoding` à
	# `Vary`, sans doublon ; il suffixe l'ETag forte de la réponse compressée (`-gzip`, `-zstd`),
	# puisque c'est une autre représentation, et retire ce suffixe de `If-None-Match` avant de
	# passer la requête à l'application, dont le `304` marche donc comme avant.
	#
	# Ce qu'il ne fait pas : il ne touche pas à une réponse déjà compressée. Les fichiers de
	# `/_app/immutable/` passent donc tels quels vers un client qui accepte brotli ou gzip :
	# adapter-node les lui sert déjà compressés. Un client qui n'accepte que zstd les reçoit en clair
	# de l'application, et `encode` les compresse. Il ne touche pas non plus à une réponse de moins
	# de 512 octets, ni aux types hors de sa liste (PNG, PDF), ni à une réponse marquée
	# `Cache-Control: no-transform`. Pour un client qui n'accepte ni gzip ni zstd, il ne compresse
	# pas et n'ajoute pas `Vary` : une réponse en clair qu'un cache partagé servirait à tous ne fait
	# de tort à personne. L'empreinte `integrity` du widget ne change pas : elle porte sur le corps
	# décodé.
	#
	# Trois écarts, relevés en 2.8.0 comme en 2.11.4, et revus en 2.11.4 avec gzip en premier. Il
	# compresse aussi une réponse `206`, mais garde le `Content-Range` de la forme brute. sirv, qui
	# sert les fichiers de `/_app/` pour adapter-node, répond aux plages. Un navigateur reçoit le
	# fichier déjà compressé en brotli ou en gzip, qu'`encode` laisse passer. Mais un client qui
	# n'accepte que zstd reçoit une plage compressée dont le `Content-Range` ne décrit pas le corps.
	# Mettre gzip en premier ne change rien pour lui. Les routes de l'application, elles, ne servent
	# pas de plages. En `HEAD`, il annonce dans `Content-Length` la taille d'un flux compressé vide :
	# 20 octets en gzip, ce que reçoit désormais un navigateur. Un `304` rend l'ETag sans le suffixe
	# de compression.
	#
	# BREACH ne trouve rien à lire ici : il lui faut, dans un même corps compressé, un secret stable
	# et un texte choisi par l'attaquant. Le nonce de la politique de contenu change à chaque
	# réponse ; aucun formulaire ne porte de jeton, SvelteKit contrôle l'origine ; le jeton de
	# session ne paraît que dans les corps de `/api/auth/get-session` et `/api/auth/list-sessions`
	# de Better Auth, qui ne reprennent rien de la requête ; les pages publiques reprennent des
	# paramètres de la requête, mais ne lisent aucune session. Une réponse qui mettrait un jeton
	# durable à côté d'un texte venu de la requête demanderait de revoir ce point.
	encode gzip zstd

	# L'application, sur la boucle locale. Compose n'y publie le port que là : rien d'autre que ce
	# reverse_proxy ne peut l'atteindre.
	reverse_proxy 127.0.0.1:3080 {
		# Caddy pose de lui-même quatre en-têtes vers l'application. Trois sont dans sa
		# documentation (`reverse_proxy`, « Defaults ») : X-Forwarded-For, X-Forwarded-Proto et
		# X-Forwarded-Host. Il jette les valeurs que la requête porte déjà pour ces trois-là, sauf
		# si elle vient d'un mandataire auquel ce Caddy fait confiance (`trusted_proxies`). Le
		# quatrième, `Via: 1.1 Caddy`, il l'ajoute depuis 2.10.0. `pnpm caddy:test` relit les quatre
		# tels que l'application les reçoit, en 2.10.0 comme en 2.11.4.
		#
		# X-Forwarded-For porte l'adresse de qui s'est connecté à Caddy. C'est le seul des quatre
		# que l'application lit, et adapter-node en prend la **dernière** valeur (`XFF_DEPTH=1`),
		# celle que Caddy a écrite. Les trois autres, personne ne les lit : l'adresse du site vient
		# d'`ORIGIN`, adapter-node ne lirait X-Forwarded-Proto et X-Forwarded-Host que sans
		# `ORIGIN`, et seulement si `PROTOCOL_HEADER` et `HOST_HEADER` les nommaient, et rien ne
		# lit `Via`.
		#
		# Jusqu'à l'étape 19, deux lignes `header_up` redisaient X-Forwarded-Proto et
		# X-Forwarded-Host. `caddy validate` les disait inutiles ; elles sont retirées, et
		# l'épreuve vérifie qu'il ne signale plus rien. Elles ne changeaient la valeur transmise
		# que dans deux cas, sans effet sur l'application qui ne la lit pas : un en-tête `Host`
		# qui porte un port, et un mandataire de confiance devant ce Caddy.

		# Une application qui ne répond plus ne doit pas retenir un visiteur indéfiniment.
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	# Les en-têtes de sécurité sont posés par l'application elle-même, route par route — c'est là
	# qu'on sait si une page publique accepte d'être encadrée (ADR 0027). Caddy n'en ajoute qu'un,
	# celui qu'il est le seul à pouvoir poser honnêtement, parce qu'il est le seul à savoir que la
	# connexion est bien en HTTPS.
	#
	# Ce bloc `header` retire des en-têtes : Caddy attend donc, pour tout ce qu'il y fait, que la
	# réponse parte vers le client (documentation de Caddy, directive `header`). Il passe après
	# `reverse_proxy` et s'applique à tout ce que l'application renvoie, `304` compris. Il ne
	# s'applique pas à une erreur que Caddy écrit lui-même : `502` quand l'application ne répond
	# pas, `504` quand elle tarde. Le code de Caddy le dit, dans `modules/caddyhttp/headers` :
	# « deferred changes do not take effect if an error occurs later in the middleware chain ». Et
	# `pnpm caddy:test` l'affiche : ce `502` porte `Server: Caddy`, et pas
	# `Strict-Transport-Security`.
	#
	# C'est une limite connue, et acceptée : à l'étape 19, le chef de projet a décidé de ne pas
	# poser `Strict-Transport-Security` sur ces `502` et `504`. Un navigateur déjà venu garde la
	# règle de transport strict deux ans, et `Server: Caddy` paraît de toute façon sur la
	# redirection de http vers https, que Caddy sert hors de ce bloc. Les deux corrections
	# possibles coûtent plus qu'elles ne rapportent. `handle_errors` ajoute des routes d'erreur au
	# serveur entier, pas au seul site : les erreurs `5xx` de tous les sites de ce Caddy, jadwal
	# compris, passeraient du niveau `error` de son journal au niveau `debug`, qu'il n'écrit pas
	# par défaut. Poser `Strict-Transport-Security` hors de ce bloc, tout de suite, le doublerait
	# sur les réponses relayées où l'application l'envoie aussi, celles de ses routes (pas les
	# fichiers de `/_app/`, qu'adapter-node sert sans passer par elles), à moins d'écrire la valeur
	# deux fois dans ce fichier.
	header {
		# Deux ans, sous-domaines compris. `preload` n'y est pas : il engage `voltia.ch` tout entier
		# auprès des navigateurs, et ce n'est pas à jadwal d'en décider. L'application envoie la même
		# valeur quand `ORIGIN` est en https ; celle d'ici remplace la sienne, et
		# `apps/web/src/lib/server/hsts.test.ts` vérifie que les deux sont identiques.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# `Server` et `Via` ne disent rien au visiteur, seulement quel logiciel sert le site : rien
		# n'oblige à le publier. Le rôle exige Caddy 2.10.0 ou plus, et depuis cette version
		# (code lu en 2.10.0 et 2.11.4 à l'étape 18) :
		#
		#   - `reverse_proxy` retire lui-même le `Server: Caddy` que Caddy pose au début de chaque
		#     réponse, et recopie les en-têtes de l'application. `-Server` enlève donc le `Server`
		#     qu'enverrait l'application. L'application n'en envoie aujourd'hui aucun ; la fausse
		#     application de `pnpm caddy:test`, un Caddy, en envoie un ;
		#   - `reverse_proxy` ajoute `Via: 1.1 Caddy` à chaque réponse de l'application, `304`
		#     compris. C'est `-Via` qui l'enlève.
		#
		# Mesuré à l'étape 19, en 2.10.0 comme en 2.11.4, en retirant une ligne à la fois : sans
		# `-Server`, les réponses relayées portent un en-tête `Server` ; sans `-Via`, chacune des
		# quatorze réponses de l'application que l'épreuve demande porte `Via: 1.1 Caddy`. Les
		# deux lignes restent, et `pnpm caddy:test` vérifie que ni l'un ni l'autre ne passe.
		#
		# `Via` se retire ici, et pas par `header_down -Via` dans `reverse_proxy`. `header_down`
		# modifie les en-têtes reçus de l'application, avant que Caddy les recopie ; `Via`, Caddy
		# l'écrit directement sur la réponse qu'il envoie, où `header_down` ne le voit pas. Essayé
		# en 2.11.4 : avec `header_down -Via`, la réponse porte toujours `Via`. Le `502` de Caddy
		# n'en porte pas, et `-Via` n'y est pour rien : sans réponse de l'application,
		# `reverse_proxy` n'en ajoute pas. `pnpm caddy:test` vérifie qu'aucune réponse ne porte
		# `Via`, ce `502` compris.
		-Server
		-Via
	}

	# `/healthz` ne va pas au journal (ADR 0039 complété). Ce n'est pas du confort : la sonde de
	# l'ADR 0038 interroge cette adresse toutes les cinq minutes, sur les deux piles, depuis le
	# serveur lui-même — **576 lignes par jour** qui ne disent rien de personne et qui, sur les
	# quatorze jours de rétention, seraient largement majoritaires. Un journal où le bruit couvre le
	# reste est un journal qu'on ne lit plus.
	#
	# Ce qui est perdu, et pourquoi c'est acceptable : une panne de la sonde ne se verra plus ici.
	# Elle se voit ailleurs, et mieux — c'est le silence des battements de cœur que la supervision
	# extérieure entend, pas une ligne de journal qu'il faudrait aller chercher.
	#
	# `log_skip` demande Caddy 2.8.0 ou plus : la directive s'appelait `skip_log` avant, et un
	# Caddyfile qui la nomme ainsi est **refusé** par une version plus ancienne. Le rôle Ansible
	# vérifie donc la version avant de poser ce fichier — sans quoi le déploiement remplacerait une
	# configuration valide par une configuration que Caddy refuse de charger.
	log_skip /healthz

	# Le journal du site, dans un fichier à lui : on lit ce que jadwal a servi, et rien d'autre.
	#
	# Un journal d'accès ordinaire est une base de données personnelles qu'on n'a pas voulue :
	# l'adresse du visiteur, la page qu'il a demandée, et — pour peu qu'une adresse porte un
	# secret — de quoi ouvrir son compte. `docs/CONDITIONS.md` promet qu'un visiteur ne laisse pas
	# d'adresse complète ; cette promesse se tient ici, pas ailleurs, parce que Caddy écrit avant
	# que l'application ne voie quoi que ce soit.
	#
	# Ce que `format filter` retire, et pourquoi chaque ligne y est :
	#
	#   - **l'adresse du visiteur**, tronquée en /24 et /48 partout où elle paraît : celle que voit
	#     Caddy (`remote_ip`), celle qu'il a résolue (`client_ip`), et celle que porte l'en-tête
	#     `X-Forwarded-For`. Un /24 garde de quoi reconnaître un abus, il ne désigne plus personne ;
	#   - **le jeton de connexion**, dans la requête comme dans le chemin. Le lien magique est un
	#     mot de passe à usage unique : `?token=…` sur `/api/auth/magic-link/verify` ouvre la
	#     session de quelqu'un. Deux formes existent, et la même expression couvre les deux ;
	#   - **l'en-tête `Referer`**, supprimé. Après la redirection du lien magique, le navigateur le
	#     renvoie avec le jeton dedans : filtrer l'adresse sans filtrer le renvoyeur ne servirait à
	#     rien. Il dit aussi d'où vient le visiteur, ce que ce service n'a pas à savoir.
	#
	# `Cookie`, `Authorization` et `Set-Cookie` ne sont pas dans la liste : Caddy les vide déjà de
	# lui-même. Vérifié, pas supposé — voir `scripts/eprouver-journal-caddy.mjs`, qui rejoue ce bloc
	# dans un conteneur et relit la ligne écrite.
	log {
		output file /var/log/caddy/jadwal.voltia.ch.log {
			roll_size 10MiB
			# Quatorze jours, et pas un de plus. `roll_keep_for` borne les fichiers déjà roulés ;
			# le fichier **courant**, lui, n'a aucune borne de temps chez Caddy, qui ne roule qu'à
			# la taille. C'est la minuterie `jadwal-journal-caddy` qui le coupe chaque nuit, et
			# l'ADR 0039 dit pourquoi ce n'est pas `logrotate` qui le fait.
			roll_keep 14
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>X-Forwarded-For ip_mask {
					ipv4 24
					ipv6 48
				}
				request>uri regexp "(token=|/reset-password/)[^&/?]+" "${1}REDACTED"
				request>headers>Referer delete
			}
		}
	}
}
