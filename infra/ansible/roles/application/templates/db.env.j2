# /etc/jadwal/db.env — produit par Ansible, ne pas modifier à la main.
#
# Quatre variables, et c'est tout ce que le conteneur de PostgreSQL a besoin de savoir. Il n'a rien
# à faire du secret de session, du mot de passe SMTP ni des adresses de battement de cœur.
#
# Lu en `format: raw` par Compose, comme celui de l'application : tel quel, sans interpolation.
#
# 0600 root:root. Pour le modifier : changer le coffre, rejouer le playbook.

POSTGRES_USER=jadwal
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB=jadwal
# Sans cela, l'image initialise la base en `trust` sur les connexions locales : n'importe quel
# processus du conteneur pourrait alors se connecter en superutilisateur sans mot de passe.
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256
