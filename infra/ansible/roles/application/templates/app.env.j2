# /etc/jadwal/app.env — produit par Ansible, ne pas modifier à la main.
#
# Ce que le conteneur de l'application reçoit, et **rien d'autre**. Ni les adresses de battement de
# cœur, ni la configuration de rclone, ni ce qui ne regarde que les tâches de l'hôte : le service
# exposé à Internet est celui qui doit en savoir le moins.
#
# Docker Compose le lit en `format: raw`, c'est-à-dire tel quel, ligne par ligne, sans interpoler —
# voir `infra/compose/docker-compose.yml`. Un `$` dans un mot de passe y reste un `$`.
#
# **Ce qui n'y est PAS, et pourquoi** (ADR 0040) : `POSTGRES_PASSWORD`, le superutilisateur de
# PostgreSQL, et `JADWAL_DB_OWNER_PASSWORD`, le propriétaire du schéma. Les deux contournent la
# sécurité par ligne — le premier par nature, le second parce qu'il possède les tables. Ils ne
# servent qu'au démarrage, pour créer les rôles et passer les migrations, et c'est le conteneur
# `init` qui les porte, le temps de quelques secondes. Le service exposé à Internet est celui qui
# doit en savoir le moins.
#
# 0600 root:root. Pour le modifier : changer le coffre, rejouer le playbook.

ORIGIN={{ jadwal_origine }}
JADWAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Vide en production : la page d'essai du widget n'a aucune raison d'y être ouverte.
JADWAL_WIDGET_TEST_ORG=

# Le nom de la base, et rien de plus : `POSTGRES_USER` nommait le superutilisateur, et l'application
# n'a plus de quoi s'y connecter.
POSTGRES_DB=jadwal
JADWAL_DB_APP_PASSWORD={{ vault_db_app_password }}
JADWAL_DB_SUPERADMIN_PASSWORD={{ vault_db_superadmin_password }}
JADWAL_DB_AUTH_PASSWORD={{ vault_db_auth_password }}
JADWAL_DB_PUBLIC_PASSWORD={{ vault_db_public_password }}

BETTER_AUTH_SECRET={{ vault_better_auth_secret }}

SMTP_HOST={{ jadwal_smtp_host }}
SMTP_PORT={{ jadwal_smtp_port }}
SMTP_USER={{ jadwal_smtp_user }}
SMTP_PASSWORD={{ vault_smtp_password }}
MAIL_FROM={{ jadwal_mail_from }}
MAIL_FROM_NAME={{ jadwal_mail_from_name }}
MAIL_REPLY_TO={{ jadwal_mail_reply_to }}
