# /etc/jadwal/init.env — produit par Ansible, ne pas modifier à la main.
#
# Ce que le conteneur de **démarrage** reçoit (ADR 0040). C'est le seul fichier du serveur qui donne
# à un conteneur les deux mots de passe privilégiés :
#
#   - `POSTGRES_PASSWORD`, le superutilisateur créé par l'image PostgreSQL. Seul lui peut créer un
#     rôle, et seul lui peut écrire `is_super_admin` (migration 0032) ;
#   - `JADWAL_DB_OWNER_PASSWORD`, le propriétaire du schéma. Il n'est ni superutilisateur ni porteur
#     de `BYPASSRLS` (ADR 0019), mais il possède les tables : c'est lui qui joue les migrations.
#
# Les cinq mots de passe applicatifs y sont aussi, parce que `bootstrap-roles.mjs` les **pose** sur
# leurs rôles : il ne peut pas les poser sans les connaître.
#
# **Ce fichier porte donc plus de secrets qu'aucun autre, et c'est assumé.** Ce qui a changé, ce
# n'est pas la quantité, c'est la durée et l'exposition : le conteneur qui le lit vit quelques
# secondes, ne publie aucun port, ne répond à personne, et s'arrête. Celui qui est exposé à Internet,
# lui, ne les voit plus jamais.
#
# Lu en `format: raw` par Compose, comme les deux autres : tel quel, sans interpolation.
#
# 0600 root:root. Pour le modifier : changer le coffre, rejouer le playbook.

POSTGRES_DB=jadwal
POSTGRES_USER=jadwal
POSTGRES_PASSWORD={{ vault_postgres_password }}

JADWAL_DB_OWNER_PASSWORD={{ vault_db_owner_password }}
JADWAL_DB_APP_PASSWORD={{ vault_db_app_password }}
JADWAL_DB_SUPERADMIN_PASSWORD={{ vault_db_superadmin_password }}
JADWAL_DB_AUTH_PASSWORD={{ vault_db_auth_password }}
JADWAL_DB_PUBLIC_PASSWORD={{ vault_db_public_password }}
