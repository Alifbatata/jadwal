# /etc/jadwal/jadwal.env — produit par Ansible, ne pas modifier à la main.
#
# Ce fichier porte tous les secrets de jadwal. Il appartient à root, il est en 0600, et rien d'autre
# sur ce serveur ne le lit : aucune autre application, aucun compte non privilégié.
# Docker le lit au lancement des conteneurs (`--env-file`), les scripts périodiques n'en tirent que
# les quelques valeurs non secrètes dont ils ont besoin, sans jamais le sourcer.
#
# Pour le modifier : changer `group_vars/all/vault.yml` (chiffré) et rejouer le playbook.

JADWAL_ORIGIN={{ jadwal_origine }}
JADWAL_IMAGE={{ jadwal_image }}
JADWAL_APP_PORT={{ jadwal_port }}
JADWAL_TRUSTED_PROXIES=127.0.0.1/32,::1/128
JADWAL_WIDGET_TEST_ORG=
# Le journal d'accès que la tâche `jadwal-journal-caddy` coupe chaque nuit (ADR 0039). C'est Caddy
# qui l'écrit, depuis son bloc de site : les deux chemins doivent se répondre.
JADWAL_JOURNAL_CADDY={{ jadwal_caddy_journal }}

POSTGRES_DB=jadwal
POSTGRES_USER=jadwal
POSTGRES_PASSWORD={{ vault_postgres_password }}
JADWAL_DB_OWNER_PASSWORD={{ vault_db_owner_password }}
JADWAL_DB_APP_PASSWORD={{ vault_db_app_password }}
JADWAL_DB_SUPERADMIN_PASSWORD={{ vault_db_superadmin_password }}
JADWAL_DB_AUTH_PASSWORD={{ vault_db_auth_password }}
JADWAL_DB_PUBLIC_PASSWORD={{ vault_db_public_password }}

BETTER_AUTH_SECRET={{ vault_better_auth_secret }}

MAIL_TRANSPORT=smtp
SMTP_HOST={{ jadwal_smtp_host }}
SMTP_PORT={{ jadwal_smtp_port }}
SMTP_USER={{ jadwal_smtp_user }}
SMTP_PASSWORD={{ vault_smtp_password }}
MAIL_FROM={{ jadwal_mail_from }}
MAIL_FROM_NAME={{ jadwal_mail_from_name }}
MAIL_REPLY_TO={{ jadwal_mail_reply_to }}
JADWAL_ALERTE_TO={{ jadwal_alerte_to }}

JADWAL_AGE_RECIPIENT={{ jadwal_age_recipient }}
JADWAL_RCLONE_REMOTE={{ jadwal_rclone_remote }}

# La sonde (ADR 0038). Elle interroge JADWAL_ORIGIN, plus haut : le nom public, donc le DNS, le
# serveur web de l'hôte et TLS. `false` ci-dessous coupe la sonde IPv6 d'une instance qui n'en a pas.
JADWAL_SONDE_IPV6={{ 'true' if jadwal_sonde_ipv6 else 'false' }}

# La veille regarde-t-elle au-delà de jadwal : toute unité en échec de la machine, et les capacités
# de Caddy. Absent ou `false` : elle ne regarde que jadwal.
JADWAL_VEILLE_MACHINE={{ 'true' if jadwal_veille_machine else 'false' }}

# Les battements de cœur (ADR 0038). Une adresse par tâche, et rien de plus : un battement ne
# transporte qu'un état et une ligne technique, jamais une donnée de la base. Ce sont des jetons —
# qui connaît l'adresse peut faire croire que la tâche va bien —, d'où le coffre.
#
# Sans ces variables, les tâches tournent exactement pareil et le disent simplement dans leur
# journal : une instance qui s'auto-héberge n'a pas à installer un service tiers pour faire
# tourner jadwal.
{% for tache, adresse in (vault_healthchecks_pings | default({})).items() %}
JADWAL_PING_{{ tache | upper | replace('-', '_') }}={{ adresse }}
{% endfor %}
