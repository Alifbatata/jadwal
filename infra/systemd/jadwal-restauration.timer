[Unit]
Description=jadwal — test de restauration, une fois par semaine

[Timer]
# Dimanche 04:30 : après la sauvegarde et les purges, à l'heure où le service est le moins demandé.
# En UTC, pour la même raison que les autres : voir jadwal-prieres.timer et l ADR 0038.
OnCalendar=Sun *-*-* 04:30:00 UTC
Persistent=true
RandomizedDelaySec=15m
AccuracySec=1min

[Install]
WantedBy=timers.target
