{
	"name": "jadwal",
	"private": true,
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
	"engines": {
		"node": ">=24.18.1"
	},
	"scripts": {
		"lint": "prettier --check . && eslint . && node scripts/controle-style.mjs",
		"format": "prettier --write .",
		"check": "pnpm -r --if-present run check",
		"test": "node scripts/tests.mjs",
		"build": "pnpm -r --if-present run build",
		"dev": "pnpm --filter @jadwal/web run dev",
		"test:tz": "pnpm --filter @jadwal/core run test:tz",
		"hooks": "node scripts/installer-hooks.mjs",
		"secrets:test": "node scripts/eprouver-controle-secrets.mjs",
		"fuites": "node scripts/controle-fuites.mjs --arbre",
		"fuites:test": "node scripts/eprouver-garde-fou.mjs",
		"style": "node scripts/controle-style.mjs",
		"prive": "node scripts/controle-dossiers-prives.mjs --arbre",
		"prive:test": "node scripts/eprouver-dossiers-prives.mjs",
		"caddy:test": "node scripts/eprouver-journal-caddy.mjs",
		"env:test": "node scripts/eprouver-env-brut.mjs",
		"veille:test": "node scripts/eprouver-veille-taches.mjs",
		"conditions:pdf": "node scripts/conditions-pdf.mjs",
		"conditions:test": "node scripts/eprouver-conditions-pdf.mjs",
		"image:test": "node scripts/eprouver-image.mjs",
		"parcours:test": "node scripts/eprouver-parcours.mjs",
		"licences": "node scripts/licences-tierces.mjs",
		"orthographe": "node scripts/orthographe.mjs"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"axe-core": "4.13.0",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"playwright-core": "1.63.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "8.70.0"
	}
}
