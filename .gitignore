# Dépendances
node_modules/

# Sorties de build
dist/
build/
.svelte-kit/
.vite/
*.tsbuildinfo
vite.config.*.timestamp-*

# Tests
coverage/

# Secrets et configuration locale
.env
.env.*
!.env.example

# Fichiers de secrets déposés à la main sur le poste. Ils ne sont ni commités, ni lus, ni
# recopiés ailleurs : ils servent à remplir le coffre, puis ils sont effacés.
secret.txt
secrets.txt
*.secret
*.secrets
/secrets/

# Les rapports d'étape ne quittent pas le poste. Un rapport recopie les sorties réelles des
# commandes de vérification, et ces sorties parlent du serveur : comptes, chemins, ports, adresses.
# Ce dépôt est public et ne parle que de jadwal — voir CLAUDE.md.
A_LIVRER/

# Tout ce qui est propre au serveur de celui qui exploite cette instance : son coffre chiffré, son
# inventaire, ses marches à suivre, ses journaux de séance. Ce dossier ne quitte jamais le poste.
#
# Ces deux lignes ne suffisent pas, et c'est voulu : `git add -f` passe outre un `.gitignore`. Le
# crochet `pre-push` refuse en plus toute poussée qui porterait un fichier de l'un de ces deux
# dossiers, quelle que soit la façon dont il y est entré.
PRIVE/

# Journaux et fichiers système
*.log
.DS_Store
Thumbs.db

# Caches d'outils
.vitest/
# Le relevé JSON que chaque paquet écrit pour « pnpm test » : un état de la dernière exécution,
# pas une source.
.vitest-resultats.json
.eslintcache

# Corbeille de sortie du transport de courriel de développement : rien ne doit y être commité.
.courriels/

# Les copies de travail du déploiement. L'original de chacune est dans `PRIVE/` — le coffre,
# l'inventaire, les valeurs propres à l'installation — et ce qui est posé ici ne vit que le temps
# d'un `ansible-playbook`. Ces lignes sont un filet : sous Windows, le déploiement se joue dans un
# conteneur jetable et rien n'est jamais posé sur le poste.
infra/ansible/group_vars/all/vault.yml
infra/ansible/inventory.ini
infra/ansible/exploitant.yml
infra/ansible/*.retry
!infra/ansible/inventory.ini.example
.orthographe/
